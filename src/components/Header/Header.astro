---
import "./Header.css";
import { Image } from "astro:assets";
import Logo from "../../assets/logo.svg";
---

<div class="header-container">
  <div class="logo-wrapper">
    <div class="logo">
      <Image
        src={Logo}
        alt="Logo da Comptel Informática para Computador"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>
