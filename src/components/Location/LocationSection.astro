---
import "./LocationSection.css";
---

<section class="location-section">
  <!-- Coluna 1: Textos -->
  <div class="location-text-container">
    <div class="text-content">
      <h2 class="location-title">Venha nos visitar!</h2>
      <p class="location-subtitle">
        Shopping Laranjeiras, loja 138<br />
        Serra, Espírito Santo
      </p>
    </div>

    <div class="location-hours">
      <h3 class="hours-title">Horário de Funcionamento</h3>
      <p class="hours-text">
        Seg a Sex - 09h ás 19h<br />
        Sab - 9h ás 18h
      </p>
    </div>
  </div>

  <!-- Coluna 2: Mapa -->
  <div class="location-map-container">
    <iframe
      width="100%"
      height="100%"
      style="border:0"
      allowfullscreen=""
      loading="lazy"
      title="Mapa de localização da empresa"
      src="https://maps.google.com/maps?hl=pt&q=Comptel%20Inform%C3%A1tica&t=k&z=17&ie=UTF8&iwloc=B&output=embed"
    ></iframe>
  </div>
</section>
