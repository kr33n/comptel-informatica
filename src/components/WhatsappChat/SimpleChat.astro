---
import { siWhatsapp } from "simple-icons";
import { siteConfig } from "../../siteConfig";
import "./SimpleChat.css";
---

<div class="chat-widget">
  <!-- Janela de Chat (Inicia oculta) -->
  <div id="chat-window" class="chat-window">
    <div class="chat-header">
      <span>Atendimento</span>
      <button id="close-chat" class="close-btn">&times;</button>
    </div>

    <div class="chat-body">
      <div class="chat-message">
        Olá! Sou o assistente virtual da Comptel Informática. Como posso te
        ajudar?
      </div>
    </div>

    <div class="chat-footer">
      <input
        type="text"
        id="chat-input"
        placeholder="Escreva sua mensagem..."
      />
      <button id="send-btn" class="send-btn">Enviar</button>
    </div>
  </div>

  <!-- Botão Flutuante -->
  <button id="chat-fab" class="chat-fab">
    <a
      href={`${siteConfig.links.whatsappUrl}${siteConfig.phone}?text=${siteConfig.whatsappText}Gostaria de falar com algum atendente`}
      aria-label="Ir para o WhatsApp"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        role="img"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="currentColor"
      >
        <path d={siWhatsapp.path}></path>
      </svg>
    </a>
  </button>
</div>
<script src="./SimpleChat.ts"></script>
