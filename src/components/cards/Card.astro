---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
}

const { title, description, imageSrc, imageAlt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/card/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);

const fileName = imageSrc.split("/").pop();
const imagePath = `/src/assets/card/${fileName}`;
const imageObject = images[imagePath]?.default;

if (!imageObject) {
  throw new Error(`Imagem não encontrada: ${fileName}`);
}
---

<article class="card">
  <div class="image-box">
    <Image
      src={imageObject}
      alt={imageAlt}
      loading="lazy"
      fetchpriority="high"
      class="card-image"
    />
  </div>

  <div class="text-box">
    <div class="text-content">
      <h3 class="title">{title}</h3>
      <p class="description">{description}</p>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    width: 100%;
    max-width: 22.66669rem;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    border-radius: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow:
      0 0.25rem 0.5rem 0 rgba(0, 0, 0, 0.02),
      0 0.375rem 0.75rem 0 rgba(0, 0, 0, 0.03);
  }

  .image-box {
    width: 100%;
    max-width: 22.66669rem;
    height: 15.375rem;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centraliza a imagem no eixo X */
    align-items: center;
    flex-shrink: 0;
    position: relative; /* Permite ajustar z-index e posicionamento livre se precisar */
    overflow: visible;
  }

  .card-image {
    height: 18rem;
    width: auto;
    object-fit: contain;
    transform: scale(1.2) translateY(-37px);
    transition: transform 0.3s ease;
  }
  /* TODO  se mexer aqui a imagem do teclado e mouse vai bugar */
  .card:last-child .card-image[data-astro-cid-rkelf5xm] {
    transform: scale(1.2) translateY(-65px) translateX(-111px);
    height: 23rem;
  }

  .text-box {
    display: flex;
    padding: 1.5rem;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2rem;
    align-self: stretch;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    align-self: stretch;
  }

  .title {
    align-self: stretch;
    color: #0f0ff5;
    font-size: 1.5rem;
    font-style: normal;
    font-weight: 600;
    line-height: 145%;
    letter-spacing: -0.03rem;
  }

  .description {
    align-self: stretch;
    color: rgba(0, 0, 0, 0.55);
    font-size: 1rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.5rem; /* 150% */
    letter-spacing: -0.005rem;
  }

  .action-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #000;
    font-size: 1.125rem;
    font-style: normal;
    font-weight: 500;
    line-height: 145%;
    letter-spacing: -0.00563rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .action-button:hover {
    opacity: 0.7;
  }
  @media (max-width: 1200px) {
    .card:last-child .card-image {
      transform: scale(1.2) translateY(-33px) translateX(-108px) !important;
      height: 21rem !important;
    }
    .card-image {
      transform: scale(1.1) translateY(-20px);
    }
  }
</style>
