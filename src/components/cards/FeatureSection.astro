---
import FeatureCards from "./FeatureCards.astro";
import Card from "./Card.astro";
import { siteConfig } from "../../siteConfig";
const actionUrl = `${siteConfig.links.whatsappUrl}${siteConfig.phone}?text=${siteConfig.whatsappText}Gostaria de falar com algum atendente`;
---

<FeatureCards>
  <Card
    title="Foco total no trabalho"
    description="Desempenho ágil para tarefas diárias. Planilhas, textos e e-mails sem travamentos irritantes."
    imageSrc="card-office.webp"
    imageAlt="Gabinete de Computador Office"
  />

  <Card
    title="Domine seus jogos"
    description="Gráficos incríveis e FPS alto. Jogue cada batalha com uma máquina montada com as melhores peças."
    imageSrc="card-gamer.webp"
    imageAlt="Gabinete de Computador Gamer RGB"
  />

  <Card
    title="Periféricos & Acessórios"
    description="Teclados, mouses, headsets e muito mais. Mais conforto, precisão e estilo para o seu dia a dia."
    imageSrc="acessorios.png"
    imageAlt="Teclado e Mouse"
  />
</FeatureCards>
