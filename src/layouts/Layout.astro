---
import WhatsAppButton from "@/components/whatsapp/WhatsAppWidget";
import SEO from "../components/SEO/SEO.astro";
const { title, description, image } = Astro.props;
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preconnect e Fontes do Google Fonts -->
    <SEO title={title} description={description} image={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta charset="utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Tag base do Favicon -->
    <link
      id="dynamic-favicon"
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
    />
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-2TKRLQHGWR"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-2TKRLQHGWR");
    </script>
    <script is:inline>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }

      // 2. Força o scroll pro topo (0,0) antes da renderização
      window.scrollTo(0, 0);
      const favicon = document.getElementById("dynamic-favicon");
      const matcher = window.matchMedia("(prefers-color-scheme: dark)");

      function updateFavicon(isDark) {
        if (favicon) {
          favicon.href = isDark ? "/favicon-dark.svg" : "/favicon-light.svg";
        }
      }

      // Executa no carregamento inicial
      updateFavicon(matcher.matches);

      // Escuta se o usuário mudar o tema do SO/Navegador em tempo real
      matcher.addEventListener("change", (e) => updateFavicon(e.matches));
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <WhatsAppButton client:idle />
  </body>
</html>
