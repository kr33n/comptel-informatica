---
/* src/layouts/Layout.astro */
import "../styles/global.css";
import SEO from "../components/SEO/SEO.astro";
import SimpleChat from "../components/WhatsappChat/SimpleChat.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ComputerStore",
      name: "Comptel Informática",
      image: "https://www.comptel.com.br/logo.png",
      "@id": "https://www.comptel.com.br",
      url: "https://www.comptel.com.br",
      telephone: "+5527996132941",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Shopping Laranjeiras, Loja 138",
        addressLocality: "Serra",
        addressRegion: "ES",
        addressCountry: "BR",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: -20.1989,
        longitude: -40.2505,
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "19:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Saturday",
          opens: "09:00",
          closes: "18:00",
        },
      ],
      sameAs: [
        "https://www.instagram.com/sua_pagina_aqui",
        "https://www.facebook.com/sua_pagina_aqui",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "A Comptel Informática monta PC Gamer e Workstations sob medida?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sim! Montamos computadores sob medida tanto para rotinas de trabalho pesado (Workstations e Home Office) quanto setups Gamer de alta performance.",
          },
        },
        {
          "@type": "Question",
          name: "Onde fica a loja da Comptel Informática?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nossa loja física fica no Shopping Laranjeiras, loja 138, em Serra, Espírito Santo. Funcionamos de segunda a sábado.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Chamada do componente de SEO otimizado -->
    <SEO title={title} description={description} image={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={Astro.site || "https://www.comptel.com.br"} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-SEU_ID_AQUI"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-2TKRLQHGWR");
    </script>
  </head>
  <body>
    <SimpleChat />
    <slot />
  </body>
</html>
