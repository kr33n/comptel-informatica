---
import Layout from "../layouts/Layout.astro";
import GeradorEtiquetas from "../components/etiquetas/GeradorEtiquetas.jsx";
---

<Layout title="Gerador de Etiquetas - Comptel Informática">
  <!-- MUDANÇA: h-screen, overflow-hidden e ajuste de padding -->
  <main
    class="h-screen bg-white pt-12 pb-8 print:h-auto print:overflow-visible print:pt-0 print:pb-0"
  >
    <GeradorEtiquetas client:load />
  </main>
</Layout>

<style is:global>
  @media print {
    header,
    footer,
    nav,
    [aria-label="Fale conosco pelo WhatsApp"] {
      display: none !important;
    }

    body {
      background-color: white !important;
      margin: 0;
      padding: 0;
    }

    @page {
      size: A4 portrait;
      margin: 0;
      overflow: unset;
    }
  }
</style>
