---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header/Header.astro";
import FeatureSection from "../components/cards/FeatureSection.astro";
import BannerSection from "../components/Banner/BannerSection.astro";
import LocationSection from "../components/Location/LocationSection.astro";
import Footer from "../components/Footer/Footer.astro";
import BannerCarousel from "../components/Hero/BannerCarousel.astro";
---

<Layout
  title="Comptel Informática"
  description="Conheça nossa solução completa de ponta a ponta para alavancar o seu negócio com alta performance."
>
  <header>
    <Header />
  </header>
  <main>
    <BannerCarousel />
    <BannerSection />
    <FeatureSection />
    <LocationSection />
  </main>
  <footer class="footer">
    <Footer />
  </footer>
</Layout>
