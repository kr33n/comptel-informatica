---
import Layout from "../layouts/Layout.astro";
import { GamerCarousel } from "@/components/hero-carousel/Carousel";
import { Header } from "@/components//header/header";

import { BrandsCarousel } from "@/components/brands-carousel/BrandsCarousel";
import { FeatureCards } from "@/components/feature-cards/FeatureCards";
import { LocationSection } from "@/components/location/LocationSection";
import { Footer } from "@/components/footer/Footer";
---

<Layout
  title="Comptel Informática"
  description="Comptel Informática - Soluções em Tecnologia da Informação e
      Comunicação. Oferecemos serviços de consultoria, suporte técnico,
      manutenção de hardware e software, além de soluções personalizadas para
      empresas e residências."
>
  <div class="flex flex-col bg-background w-full">
    <Header client:only="react" />
    <GamerCarousel client:only="react" />
    <BrandsCarousel client:only="react" />
    <FeatureCards client:only="react" />
    <LocationSection client:only="react" />
    <Footer client:only="react" />
  </div>
</Layout>
