---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
// Importe a foto de perfil caso vá usar a tag Image do Astro
import profileImg from "../assets/logo.svg";
import { siteConfig } from "../siteConfig";
const siteOrigin = Astro.url.origin;

// 1. Dados do Perfil
const profile = {
  name: "Nome da sua Marca",
  bio: "Soluções em tecnologia e setups personalizados.",
  avatarUrl: profileImg, // Exemplo com URL externa
};

// 2. Lista Dinâmica de Links
const links = [
  {
    title: "Site Oficial",
    // Note o formato wa.me com o código do Brasil (55) e o DDD (27)
    url: siteOrigin, // Link para o site oficial
    color: "#0000ff", // Cor oficial do WhatsApp
  },
  {
    title: "Fale conosco no WhatsApp",
    // Note o formato wa.me com o código do Brasil (55) e o DDD (27)
    url: `${siteConfig.links.whatsappUrl}${siteConfig.phone}?text=${siteConfig.whatsappText}Gostaria de falar com algum atendente`,
    color: "#25D366", // Cor oficial do WhatsApp
  },
  {
    title: "Acompanhe no Instagram",
    url: `${siteConfig.links.instagram}`,
    color: "#E1306C", // Cor base do Instagram
  },
  {
    title: "Curta nossa página no Facebook",
    url: `${siteConfig.links.facebook}`,
    color: "#1877F2", // Cor oficial do Facebook
  },
];
---

<style>
  .chat-widget {
    display: none !important;
  }
</style>

<Layout
  title="Comptel Informática - Soluções de TI"
  description="Conheça nossa solução completa de ponta a ponta para alavancar o seu negócio com alta performance."
>
  <html lang="pt-BR">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{siteConfig.name} | Links</title>
    </head>
    <body class="linktree-body">
      <main class="container">
        <!-- Cabeçalho (Foto, Nome e Bio) -->
        <header class="profile-header">
          <Image
            src={profileImg}
            alt={`Foto de ${siteConfig.name}`}
            class="avatar"
          />
          <h1 class="name">{siteConfig.name}</h1>
          <p class="bio">{profile.bio}</p>
        </header>

        <!-- Lista de Links -->
        <nav class="links-container">
          {
            links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link-button"
                style={`--hover-color: ${link.color};`}
              >
                {link.title}
              </a>
            ))
          }
        </nav>
      </main>
    </body>
  </html>
</Layout>
<style>
  /* Reset básico para a página de links */
  :global(body) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Fundo da página (pode usar o azul do seu banner aqui) */
  .linktree-body {
    min-height: 100vh;
    background: linear-gradient(135deg, #0b0b0b 0%, #060707 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
  }

  /* Container central que segura tudo */
  .container {
    width: 100%;
    max-width: 40rem; /* Limita a largura no desktop para não ficar esticado */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  /* Cabeçalho do Perfil */
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #ffffff;
    gap: 1rem;
  }

  .avatar {
    width: 12rem; /* Bem mais largo para acomodar o nome da empresa */
    height: 4.5rem; /* Altura menor para eliminar o excesso de fundo branco */
    border-radius: 0.75rem; /* Arredondamento suave nos cantos */
    object-fit: contain;
    background-color: #ffffff; /* Mantém o fundo branco para destacar a logo azul */
    padding: 0.5rem 1rem; /* Respiro menor em cima/embaixo e maior nas laterais */
    border: none; /* Removemos a borda extra para um visual mais limpo */
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    box-sizing: border-box;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .bio {
    font-size: 1rem;
    margin: 0;
    opacity: 0.9;
    max-width: 25rem;
    line-height: 1.4;
  }

  /* Container dos Botões */
  .links-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  /* Estilo dos Botões */
  .link-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 1.25rem;
    background: #ffffff;
    color: #333333;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    border-radius: 3rem; /* Bordas bem arredondadas, estilo pílula */
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
  }

  /* Efeito de Hover Dinâmico puxando a cor da variável CSS */
  .link-button:hover {
    transform: scale(1.02) translateY(-2px);
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
    color: var(--hover-color); /* O texto ganha a cor da rede social no hover */
  }

  /* Responsividade para telas menores */
  @media (max-width: 480px) {
    .link-button {
      padding: 1rem;
      font-size: 1rem;
    }
    .avatar {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
</style>

<script>
  const chat = document.querySelector<HTMLElement>(".chat-widget");

  if (chat) {
    chat.style.setProperty("display", "none", "important");
  }
</script>
