---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../siteConfig";
import logoComptel from "@/assets/logo-branding-horizontal.svg";

const siteOrigin = Astro.url.origin;

const profile = {
  bio: "Especialista em computadores! PCs Gamer, office, notebooks e periféricos de elite em Serra/ES. Visite nossa loja no Shopping Laranjeiras e monte sua máquina ideal",
  logoUrl: logoComptel, // Substitua pela imagem da sua logo
};

const links = [
  {
    title: "Site Oficial",
    url: siteOrigin,
    hoverColor: "#1919FE",
  },
  {
    title: "WhatsApp",
    url: `${siteConfig.links.whatsappUrl}${siteConfig.phone}?text=${encodeURIComponent(siteConfig.whatsappText + "Gostaria de falar com algum atendente")}`,
    hoverColor: "#25D366",
  },
  {
    title: "Instagram",
    url: siteConfig.links.instagram,
    hoverColor: "#E1306C",
  },
  {
    title: "Facebook",
    url: siteConfig.links.facebook,
    hoverColor: "#1877F2",
  },
  {
    title: "Localização",
    url: "https://maps.app.goo.gl/qd6Seq3cpC3bUQNc8",
    hoverColor: "#EA4335",
  },
];
---

<Layout title={`${siteConfig.name} | Links`} description={profile.bio}>
  <main
    class="min-h-screen bg-[#050505] text-white flex flex-col items-center justify-center px-4 py-12 font-sans"
  >
    <div class="w-full max-w-md flex flex-col items-center gap-8">
      <header class="flex flex-col items-center text-center gap-4">
        <div
          class="bg-white p-4 rounded-2xl w-48 h-20 flex items-center justify-center shadow-lg"
        >
          <img
            src={profile.logoUrl.src}
            alt={siteConfig.name}
            class="max-w-full max-h-full object-contain"
          />
        </div>

        <h1 class="text-2xl font-bold tracking-tight text-white mt-2">
          {siteConfig.name}
        </h1>

        <p class="text-sm text-gray-300 max-w-sm leading-relaxed opacity-90">
          {profile.bio}
        </p>
      </header>

      <nav class="w-full flex flex-col gap-4">
        {
          links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link-btn w-full py-4 px-6 bg-white text-gray-900 font-semibold text-center text-base rounded-full shadow-md transition-all duration-300 transform hover:-translate-y-0.5 hover:scale-[1.01] hover:shadow-xl cursor-pointer"
              style={`--hover-color: ${link.hoverColor};`}
            >
              {link.title}
            </a>
          ))
        }
      </nav>
    </div>
  </main>
</Layout>

<style>
  .link-btn:hover {
    color: var(--hover-color);
  }

  :global(.fixed.bottom-6) {
    display: none !important;
  }
</style>
